{
  "name": "pictotalk",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:app": "npm --prefix apps/mobile run start",
    "install:all": "npm install && npm --prefix apps/web install && npm --prefix apps/mobile install",
    "deploy": "sst deploy --stage production",
    "deploy:dev": "sst deploy --stage dev",
    "voice-pack": "node scripts/voice-pack/generate.mjs"
  },
  "devDependencies": {
    "sst": "^4.17.2"
  }
}
