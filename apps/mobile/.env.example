# All optional. The app works with none of these set: device voice + ARASAAC direct.
# Set by sst.config.ts when the web app is deployed; set them in EAS for iOS builds.
EXPO_PUBLIC_VOICE_PACK_URL=https://cdn.pictotalk.org/voice/kokoro-v1
EXPO_PUBLIC_ARASAAC_STATIC=https://cdn.pictotalk.org/arasaac
