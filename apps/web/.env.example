# Where the web version of the app is served (the SST "App" site). Set automatically by sst.config.ts on deploy.
NEXT_PUBLIC_APP_URL=https://app.pictotalk.org
# Optional: App Store link, shown once the iOS app is live.
NEXT_PUBLIC_APP_STORE_URL=
# Contact address shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=hello@pictotalk.org
